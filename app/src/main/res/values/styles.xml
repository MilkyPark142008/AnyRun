<resources>

    <!--
        系统默认主题：Material 3。
        parent 用 Theme.Material3.Light（带窗口 ActionBar，设置页 / 历史页依赖它）；
        自带工具栏的页面（主界面、脚本等）继续叠加 AppTheme.NoActionBar。
        注意：Material3 没有 DarkActionBar 变体，ActionBar 配色跟随 M3 色板。
    -->
    <style name="AppTheme" parent="Theme.Material3.Light">
        <!-- 沿用原青绿主色，映射到 M3 色板（容器色见 colors.xml） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 无ActionBar -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!--
        悬浮窗（摇杆 / 地图按钮）里按钮的视图级主题：自成一体的 AppCompat 浅色主题，
        不随全局 M3 切换，保持悬浮窗按钮原有的轻量观感。
    -->
    <style name="RippleWhite"  parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- 点击后波纹的颜色 -->
        <item name="android:colorControlHighlight">#C8C9CA</item>
        <!-- 效果半径-->
        <item name="android:radius">14dp</item>
    </style>

    <!-- dialog动画 -->
    <style name="DialogAnimFadeInFadeOut" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/anim_fade_in</item>
        <item name="android:windowExitAnimation">@anim/anim_fade_out</item>
    </style>

    <!--
        兼容保留：全局已不再覆写 buttonStyle，按钮使用 M3 默认样式
        （Widget.Material3.Button）。个别布局仍可单独引用本样式。
    -->
    <style name="AppTheme.Button" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/colorAccent</item>
    </style>

</resources>
