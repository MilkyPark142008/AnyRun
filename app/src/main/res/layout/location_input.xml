<?xml version="1.0" encoding="utf-8"?>
<!-- 手动输入经纬度：经度 / 纬度分栏输入，粘贴整串坐标时自动分填 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/input_position_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:text="@string/input_position_tips"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_position_lng"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:fontFamily="monospace"
                android:hint="@string/input_position_lng_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/input_position_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:fontFamily="monospace"
                android:hint="@string/input_position_lat_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal"
                android:minHeight="48dp" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/input_position_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/pos_type_gps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/input_position_gps" />

            <RadioButton
                android:id="@+id/pos_type_bd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_position_baidu" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/input_position_paste"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_position_paste" />

            <Button
                android:id="@+id/input_position_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_position_cancel" />

            <Button
                android:id="@+id/input_position_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_position_ok" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
