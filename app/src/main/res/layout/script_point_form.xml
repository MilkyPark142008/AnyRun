<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 / 编辑单个路点的表单：经度、纬度分栏填写 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <RadioGroup
            android:id="@+id/script_form_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/script_form_walk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/script_mode_walk" />

            <RadioButton
                android:id="@+id/script_form_run"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/script_mode_run" />

            <RadioButton
                android:id="@+id/script_form_bike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/script_mode_bike" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/script_form_lng"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:hint="@string/input_position_lng_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />

            <EditText
                android:id="@+id/script_form_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:hint="@string/input_position_lat_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />
        </LinearLayout>

        <EditText
            android:id="@+id/script_form_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/script_point_speed_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/script_form_wait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/script_point_wait_hint"
            android:importantForAutofill="no"
            android:inputType="number" />

        <!-- 仅编辑模式显示：删除 / 上移 / 下移 -->
        <LinearLayout
            android:id="@+id/script_form_ops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/script_form_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/script_point_delete" />

            <Button
                android:id="@+id/script_form_up"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/script_point_up" />

            <Button
                android:id="@+id/script_form_down"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/script_point_down" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
