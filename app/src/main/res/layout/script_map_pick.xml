<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/script_map_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:text="@string/script_map_tips"
        android:textSize="12sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/script_map"
        android:layout_width="match_parent"
        android:layout_height="320dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Spinner
            android:id="@+id/script_map_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/script_map_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/script_map_clear" />

        <Button
            android:id="@+id/script_map_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/script_map_close" />
    </LinearLayout>

</LinearLayout>
